# ==========================================
# Petpedia Environment Variables Template
# ==========================================

# ------------------------------------------
# Shopify Storefront API Configuration
# (Shopify Admin -> Sales Channels -> Headless)
# ------------------------------------------
VITE_SHOPIFY_STORE_DOMAIN=1fcjnw-tz.myshopify.com
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_storefront_access_token
VITE_SHOPIFY_API_VERSION=2026-01
VITE_USE_MOCK_DATA=false

# ------------------------------------------
# Shopify Admin API Configuration (Server-Side Only)
# (Shopify Dev Dashboard or Admin -> Settings -> Develop Apps)
# ------------------------------------------
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
SHOPIFY_ADMIN_ACCESS_TOKEN=your_direct_shopify_admin_access_token
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_signing_secret
SHOPIFY_LOCATION_ID=gid://shopify/Location/86156607682

# ------------------------------------------
# Admin Security & Session Management
# ------------------------------------------
ADMIN_PASSCODE=your_secure_admin_passcode
ADMIN_SESSION_SECRET=your_32_byte_hmac_secret_for_admin_sessions
CUSTOMER_SESSION_SECRET=your_32_byte_hmac_secret_for_customer_sessions

# ------------------------------------------
# Google Analytics 4 Measurement ID
# ------------------------------------------
VITE_GA_MEASUREMENT_ID=G-FJLTTPJCKL

# ------------------------------------------
# Google OAuth Configuration (Server-Side Only)
# ------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------
# MSG91 SMS & OTP Provider Configuration
# ------------------------------------------
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_OTP_TEMPLATE_ID=your_msg91_template_id
MSG91_ORDER_TEMPLATE_ID=your_msg91_order_flow_id
MSG91_OTP_LENGTH=4
MSG91_OTP_EXPIRY=10

# ------------------------------------------
# Shiprocket Fastrr Configuration
# ------------------------------------------
FASTRR_API_KEY=your_fastrr_api_key
FASTRR_API_SECRET=your_fastrr_api_secret

# ------------------------------------------
# Web Push Notifications (VAPID)
# ------------------------------------------
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@petpedia.in

# ------------------------------------------
# Persistent Serverless Storage & Rate Limiting
# (Vercel KV / Upstash Redis REST - required for multi-instance serverless deployments)
# ------------------------------------------
KV_REST_API_URL=https://your-database-id.upstash.io
KV_REST_API_TOKEN=your_upstash_rest_token
FASTRR_API_BASE=https://apigateway.pickrr.com

# ------------------------------------------
# Automated Customer Invoice & Email (Resend)
# ------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Petpedia <orders@petpedia.in>
APP_URL=https://www.petpedia.in

