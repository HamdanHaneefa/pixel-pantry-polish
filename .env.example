# Shopify Storefront API Configuration
# Replace these with your actual Shopify store credentials from Shopify Admin -> Sales Channels -> Headless

VITE_SHOPIFY_STORE_DOMAIN=your-shop-name.myshopify.com
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_storefront_access_token
VITE_SHOPIFY_API_VERSION=2025-04

# Set to "true" to force mock data fallback even if credentials exist, or "false" to use live Shopify
VITE_USE_MOCK_DATA=false

# Google Analytics 4 Measurement ID
VITE_GA_MEASUREMENT_ID=G-FJLTTPJCKL

